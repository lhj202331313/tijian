<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boy.wang.doctorservice.mapper.OverallResultMapper">

    <resultMap id="overallResultMap" type="boy.wang.doctorservice.entity.OverallResult">
        <id property="id" column="id"/>
        <result property="orderId" column="order_id"/>
        <result property="doctorId" column="doctor_id"/>
        <result property="summary" column="summary"/>
        <result property="doctorName" column="doctor_name"/>
        <result property="resultStatus" column="result_status"/>
        <result property="createTime" column="create_time"/>
        <result property="publishTime" column="publish_time"/>
        <result property="status" column="status"/>
    </resultMap>

    <sql id="columns">
        id, order_id, doctor_id, summary, doctor_name, result_status, create_time, publish_time, status
    </sql>

    <select id="findByOrderId" resultMap="overallResultMap">
        SELECT <include refid="columns"/>
        FROM overallresult
        WHERE order_id = #{orderId}
    </select>

    <select id="findById" resultMap="overallResultMap">
        SELECT <include refid="columns"/>
        FROM overallresult
        WHERE id = #{id}
    </select>

    <insert id="insert" parameterType="boy.wang.doctorservice.entity.OverallResult" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO overallresult (order_id, doctor_id, summary, doctor_name, result_status, create_time, publish_time, status)
        VALUES (#{orderId}, #{doctorId}, #{summary}, #{doctorName}, #{resultStatus}, #{createTime}, #{publishTime}, #{status})
    </insert>

    <update id="update" parameterType="boy.wang.doctorservice.entity.OverallResult">
        UPDATE overallresult
        SET summary = #{summary},
            result_status = #{resultStatus}
        WHERE id = #{id}
    </update>

    <update id="updatePublish">
        UPDATE overallresult
        SET status = 1,
            publish_time = #{publishTime}
        WHERE id = #{id}
    </update>
</mapper>
