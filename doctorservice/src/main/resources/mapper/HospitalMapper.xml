<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boy.wang.doctorservice.mapper.HospitalMapper">

    <resultMap id="hospitalMap" type="boy.wang.doctorservice.entity.Hospital">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="address" column="address"/>
        <result property="phone" column="phone"/>
        <result property="businessHours" column="business_hours"/>
        <result property="ruleDesc" column="rule_desc"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="findById" resultMap="hospitalMap">
        SELECT id, name, address, phone, business_hours, rule_desc, status
        FROM hospital
        WHERE id = #{id}
    </select>
</mapper>
