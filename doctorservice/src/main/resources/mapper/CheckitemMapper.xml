<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boy.wang.doctorservice.mapper.CheckitemMapper">

    <resultMap id="checkitemMap" type="boy.wang.doctorservice.entity.Checkitem">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="type" column="type"/>
        <result property="sortNo" column="sort_no"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="findById" resultMap="checkitemMap">
        SELECT id, name, type, sort_no, status
        FROM checkitem
        WHERE id = #{id}
    </select>

    <select id="findBySetmealId" resultMap="checkitemMap">
        SELECT c.id, c.name, c.type, c.sort_no, c.status
        FROM checkitem c
        INNER JOIN setmealdetailed sd ON sd.checkitem_id = c.id
        WHERE sd.setmeal_id = #{setmealId}
        ORDER BY c.sort_no, c.id
    </select>
</mapper>
