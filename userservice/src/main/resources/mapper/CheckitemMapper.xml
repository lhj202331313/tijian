<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="boy.wang.userservice.mapper.CheckitemMapper">

    <resultMap id="checkitemResultMap" type="boy.wang.userservice.entity.Checkitem">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="sort_no" property="sortNo"/>
        <result column="status" property="status"/>
    </resultMap>

    <sql id="baseColumns">
        id, name, type, sort_no, status
    </sql>

    <select id="selectById" resultMap="checkitemResultMap">
        SELECT <include refid="baseColumns"/>
        FROM checkitem
        WHERE id = #{id}
    </select>

    <select id="selectBySetmealId" resultMap="checkitemResultMap">
        SELECT c.id, c.name, c.type, c.sort_no, c.status
        FROM checkitem c
        INNER JOIN setmealdetailed sd ON sd.checkitem_id = c.id
        WHERE sd.setmeal_id = #{setmealId} AND c.status = 1
        ORDER BY c.sort_no ASC
    </select>

    <select id="selectAllActive" resultMap="checkitemResultMap">
        SELECT <include refid="baseColumns"/>
        FROM checkitem
        WHERE status = 1
        ORDER BY sort_no ASC
    </select>

</mapper>
